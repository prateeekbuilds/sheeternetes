#!/usr/bin/env bash
#
# Sheetlux CD — GitOps for Sheeternetes. Continuously reconciles a directory of
# manifests into the cluster: pull (if it's a git repo), then `skctl apply` every
# manifest. Because apply is idempotent (upsert), the cluster converges to Git.
#
#   ./sheetlux [dir]        # default: ./gitops   (Ctrl-C to stop)
#   INTERVAL=15 ./sheetlux ~/my-manifests
#
# The declared state in Git is the source of truth, exactly like Flux/Argo — just
# smaller, funnier, and backed by a spreadsheet.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
DIR="${1:-$here/gitops}"
INTERVAL="${INTERVAL:-15}"
SKCTL="$here/skctl"

[ -d "$DIR" ] || { echo "no such directory: $DIR" >&2; exit 1; }
echo "[sheetlux] watching $DIR every ${INTERVAL}s (source of truth)"

last=""
while true; do
  # pull if this is a git working tree
  if git -C "$DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$DIR" pull --quiet --ff-only 2>/dev/null || true
  fi
  # checksum of all manifests; only apply when something changed
  now="$(cat "$DIR"/*.json 2>/dev/null | shasum | awk '{print $1}')"
  if [ "$now" != "$last" ]; then
    echo "[sheetlux] change detected -> syncing"
    for m in "$DIR"/*.json; do
      [ -e "$m" ] || continue
      echo "[sheetlux] apply $(basename "$m")"
      "$SKCTL" apply "$m" >/dev/null && echo "  ok" || echo "  FAILED"
    done
    last="$now"
  fi
  sleep "$INTERVAL"
done
